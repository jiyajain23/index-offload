# LIFELINE Environment Configuration

# -------------------------------------------------------------
# Qdrant Server & Ingestion Service (Required only if using remote Qdrant / Qdrant Cloud)
# -------------------------------------------------------------
# URL to your Qdrant cluster (e.g., Qdrant Cloud or remote server)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333

# Your Qdrant API Key (leave empty for local unauthenticated instances)
QDRANT_API_KEY=your_qdrant_api_key_here

# -------------------------------------------------------------
# LIFELINE Edge Backend Configuration (Optional overrides)
# -------------------------------------------------------------
# Local data directory for SQLite & embedded Qdrant Edge shards
LIFELINE_EDGE_DATA=./edge_data

# URL of the upstream ingestion server
LIFELINE_SERVER_URL=http://localhost:8001

# Soft memory budget limit in MB
LIFELINE_SOFT_BUDGET_MB=400

# Enable demo mode (generates video fixture & demo procedure shards)
LIFELINE_DEMO=1

# -------------------------------------------------------------
# Frontend Configuration
# -------------------------------------------------------------
# Target API URL for the React / Vite frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
